# services.env -- optional add-on services for the AllStar transcriber.
#
# Install at /opt/allstar-transcriber/services.env
#
# Everything in this file is OFF-BY-DEFAULT-SAFE: the pipeline that captures
# audio, transcribes it and stores it runs exactly the same whether these are
# on or off. These flags govern add-ons that write only to their own tables.
#
# Anyone running this stack who wants nothing but capture + transcription can
# set ENABLE_CALLSIGN_RESOLVER=0, never create the resolver tables, and never
# enable the timer. Hunter's original schema and analyzer are untouched either
# way.

# ---------------------------------------------------------------------------
# Callsign resolver
# ---------------------------------------------------------------------------
# Converts spoken phonetics in transcripts into callsigns and records them in
# callsign_mentions / callsign_roster. Never modifies transcript text.
ENABLE_CALLSIGN_RESOLVER=1

# Rows examined per run. The timer fires every 5 minutes, so this only needs to
# exceed the number of transmissions in 5 minutes; the larger value is for
# chewing through history on the first pass.
RESOLVER_BATCH_LIMIT=2000

# ---------------------------------------------------------------------------
# Head-truncation repair  (start with this OFF)
# ---------------------------------------------------------------------------
# The commonest error in this data is the FIRST phonetic word going missing --
# "Delta 9 uniform Juliet kilo golf" is KD9UJK with the "kilo" clipped, most
# likely by PTT/link key-up eating the start of the transmission. What survives
# is a proper suffix of the real callsign.
#
# With this on, a parsed callsign that is a suffix of EXACTLY ONE roster entry
# is repaired to that entry and recorded at confidence 0.6, with the truncated
# form preserved in matched_text so the repair stays visible.
#
#   D9UJK  -> KD9UJK        N6H -> NN6H
#
# Off by default because it is the only part of the resolver that infers rather
# than reads. Turn it on once callsign_roster has some history you have looked
# at. Note that unrepaired truncations are dropped anyway by the prefix rule --
# no country issues a bare D, A or O prefix -- so leaving this off costs you
# accuracy, never correctness.
ENABLE_ROSTER_MATCH=0

# How many high-confidence sightings a callsign needs before the fuzzy pass
# will propose it. Higher = more conservative.
ROSTER_MIN_SIGHTINGS=3
