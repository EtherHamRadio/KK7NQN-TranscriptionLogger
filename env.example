# Copy to ami.env and netviewer.env, fill in real values, then chmod 600 both.
# Never commit the filled-in versions.

# --- Database (all components) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=transcriber
DB_PASS=CHANGE_ME
DB_NAME=repeater

# --- ami_ptt_recorder.py ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=CHANGE_ME
AMI_PASS=CHANGE_ME
NODE_NUM=000000
RECORD_DIR=/opt/allstar-transcriber/recordings/incoming
STAGING_DIR=/opt/allstar-transcriber/recordings/staging
FINALIZE_DELAY=2.0
LOG_FILE=/opt/allstar-transcriber/logs/ptt_recorder.log
AMI_DEBUG=0

# --- netviewer.py ---
NETVIEWER_PORT=8088

# --- Transcript_Analyzer.py ---
SESSION_GAP_MIN=10
RESCAN_MINUTES=120
BATCH_LIMIT=2000
NET_SCORE_THRESHOLD=1.0
CPU_THRESHOLD=50
DRY_RUN=0
LOG_LEVEL=INFO

# --- AI refinement (disabled; untested in this fork) ---
AI_ENABLE=0
